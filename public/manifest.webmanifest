{
  "name": "GeoDeck Globe",
  "short_name": "GeoDeck",
  "description": "手機優先的 3D 地球情報地圖：天氣、交通、停車、天空即時資訊",
  "lang": "zh-Hant",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#04080d",
